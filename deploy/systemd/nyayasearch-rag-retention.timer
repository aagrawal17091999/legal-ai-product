# Runs the retention service daily at 03:00. Persistent=true so a missed run
# (box was down at 03:00) fires
# on next boot instead of being skipped for the day.
[Unit]
Description=Daily NyayaSearch RAG audit retention cleanup

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true

[Install]
WantedBy=timers.target
