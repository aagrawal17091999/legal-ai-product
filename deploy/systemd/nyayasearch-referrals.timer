# Hourly, at :20 (clear of the 04:00 credit refill). Idempotent, and a no-op
# unless a webhook died between banking a reward and paying it.
#
# Persistent=true: a run missed while the box was down fires on next boot.
[Unit]
Description=Hourly NyayaSearch referral program tick

[Timer]
OnCalendar=*-*-* *:20:00
Persistent=true

[Install]
WantedBy=timers.target
