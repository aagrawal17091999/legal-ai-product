# Copy this to `.env.production.local` ON THE BOX and fill in the real values.
#   cp .env.production.local.example .env.production.local
#   chmod 600 .env.production.local        # secrets — lock it down
# NEVER commit the filled-in file (it's covered by .gitignore's .env.production*).

# --- Database (Postgres runs ON this box; use localhost, not the public IP) ---
DATABASE_URL=postgresql://legaladmin:<password>@127.0.0.1:5432/legaldb

# --- App URL ---
NEXT_PUBLIC_APP_URL=https://getlegalbrain.com

# --- Cron / retention (generate: openssl rand -hex 32) ---
CRON_SECRET=<cron-secret>

# --- Backups (generate: openssl rand -base64 32; store in your password manager) ---
BACKUP_ENC_PASSPHRASE=<backup-passphrase>

# --- Alerts (Slack incoming webhook) ---
ALERT_WEBHOOK_URL=<slack-webhook-url>

# --- AI providers ---
ANTHROPIC_API_KEY=<anthropic-key>
VOYAGE_API_KEY=<voyage-key>

# Chat model. Defaults to claude-sonnet-5 (faster than 4-6 at the same list
# price). Shared by the research agent AND doc chat. Two things to know before
# changing it:
#   - Anything set here MUST have a row in RATES (src/lib/billing/cost.ts).
#     An unpriced model meters as zero and every turn bills as free.
#   - On Sonnet 5, omitting `thinking` runs ADAPTIVE thinking; on 4.6 omitting
#     it meant none. Both call sites now disable it explicitly, so switching
#     models is a speed change and not a silent behaviour change.
# CHAT_MODEL=claude-sonnet-5

# Extended thinking for the research agent: unset = off (current tuning).
# Set to low|medium|high|max to enable adaptive thinking at that effort. Costs
# latency on the critical path, so change it with the evals, not by feel.
# AGENT_EFFORT=

# Verify and release the answer a paragraph at a time while the model writes it
# (src/lib/rag/progressiveGate.ts). Set to "off" for the older behaviour:
# generate the whole answer, grade it, then reveal it.
# PROGRESSIVE_GROUNDING=on

# Sarvam (OCR reading + translation). Without the key the pipeline silently
# falls back to Claude vision for everything, which still works but costs
# materially more per page. SARVAM_OCR_ENABLED must be the literal "on".
SARVAM_API_KEY=<sarvam-key>
SARVAM_OCR_ENABLED=on

# --- Billing ---
# MUST be "on" in production. Anything else (including unset) is SHADOW MODE:
# usage is recorded for COGS analytics but the wallet is never debited and no
# user is ever blocked — i.e. you serve paid-tier AI for free, silently.
# Do not flip this on until the in-app credit meter + top-up flow are live,
# or users will hit a 402 with no way to recover.
BILLING_ENFORCE=on

# --- Analytics (Mixpanel) ---
# Optional: with no token every track() call is a silent no-op, so the app runs
# fine without it. Server-side events (signup, payments, messages, job outcomes)
# are sent from the box; the browser only sends clicks, via /api/analytics/event,
# so the token never reaches the client bundle — do NOT prefix it NEXT_PUBLIC_.
MIXPANEL_TOKEN=<mixpanel-project-token>
# Region must match where the Mixpanel project was created (US projects use the
# default; EU/India projects have their own residency endpoints):
#   US     api.mixpanel.com     (default if unset)
#   EU     api-eu.mixpanel.com
#   India  api-in.mixpanel.com
MIXPANEL_API_HOST=api-in.mixpanel.com

# Browser SDK (OPTIONAL). Set these to also capture referrer, UTM parameters,
# device, and session stitching — the things a server cannot see, and the only
# way to tell WHICH CHANNEL produced a signup. Leave unset for server-only
# analytics; clicks then relay through /api/analytics/event instead.
#
# It is the SAME project token as above. A browser token is public by nature
# (that is true of every client-side analytics install), which is exactly why
# signups, payments, and job outcomes stay server-side where they can't be
# forged. Must be the same region as MIXPANEL_API_HOST or client and server
# events land in different projects.
#
# NEXT_PUBLIC_* is baked in at BUILD time — changing these needs a rebuild,
# not just a pm2 reload.
NEXT_PUBLIC_MIXPANEL_TOKEN=<same-mixpanel-project-token>
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-in.mixpanel.com

# --- Cloudflare R2 (storage) ---
# ONE bucket holds everything: the judgment corpus (`supreme-court/`) that the
# ingestion pipeline uploads, plus user data (`workspaces/`, `ocr/`,
# `translations/`, `app-backups/`). Citation PDF links are presigned from
# (year, path) at click time against THIS bucket, so pointing it at a bucket
# without the corpus makes every "Open full judgment" link return R2's raw
# NoSuchKey XML. The credentials must be scoped to the same bucket.
R2_ENDPOINT=<r2-endpoint>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=legal-judgments

# --- Log shipping: Grafana Cloud Loki (scripts/install-alloy.sh) ---
# From Grafana Cloud -> Connections -> Loki -> Details. The free tier covers
# 50GB/month with 14-day retention, which is why rotated logs are ALSO archived
# to R2 (scripts/archive-logs.sh) for anything older than that window.
# LOKI_PASSWORD is an access-policy token with logs:write — a secret; it is
# written to /etc/default/alloy (0600) and must never be pasted into
# deploy/alloy/config.alloy, which is tracked in git.
LOKI_URL=https://logs-prod-<n>.grafana.net/loki/api/v1/push
LOKI_USER=<numeric-loki-instance-id>
LOKI_PASSWORD=<grafana-cloud-access-token>

# --- Firebase (public web config — safe to expose; from Firebase console) ---
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>

# --- Firebase Admin (SECRET service-account JSON, as ONE line) ---
# Paste the whole JSON on a single line, single-quoted; keep the \n escapes inside private_key.
FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ... }'

# --- Razorpay (LIVE mode values — fill once you do the live cutover) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=<razorpay-live-key-id>
RAZORPAY_KEY_ID=<razorpay-live-key-id>
RAZORPAY_KEY_SECRET=<razorpay-live-key-secret>
RAZORPAY_PLAN_MONTHLY=<razorpay-live-plan-monthly>
RAZORPAY_PLAN_YEARLY=<razorpay-live-plan-yearly>
RAZORPAY_WEBHOOK_SECRET=<razorpay-live-webhook-secret>
