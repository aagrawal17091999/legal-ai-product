# Hourly, at :20 (clear of the 04:00 credit refill), so a reward lands within
# the hour its referral's window closes. Every step is idempotent.
#
# Persistent=true: a run missed while the box was down fires on next boot.
[Unit]
Description=Hourly NyayaSearch referral program tick

[Timer]
OnCalendar=*-*-* *:20:00
Persistent=true

[Install]
WantedBy=timers.target
