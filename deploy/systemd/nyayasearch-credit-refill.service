# Issues the monthly credit refills that no Razorpay webhook will ever cover,
# and expires lapsed comped plans.
# See src/app/api/cron/credit-refill/route.ts for why this is needed:
#   * YEARLY subscribers — the Pro allowance is per month, but Razorpay fires
#     subscription.charged once a YEAR on the yearly plan.
#   * COMPED plans (staff-granted, migration 029) — no money moves and no
#     subscription exists, so no webhook fires at all. This job both tops them up
#     monthly and downgrades them once the comp expires.
#
# Install (as root):
#   cp deploy/systemd/nyayasearch-credit-refill.* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now nyayasearch-credit-refill.timer
#
# `User=` and `WorkingDirectory=` are placeholders — bootstrap-box.sh rewrites
# both to the box's actual run user / checkout path.
[Unit]
Description=NyayaSearch monthly credit refill (yearly + comped plans)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/legal-ai-product
Environment=ENV_FILE=.env.production.local
Environment=CRON_TARGET_BASE=http://127.0.0.1:3000
ExecStart=/bin/bash scripts/cron-tick.sh /api/cron/credit-refill
