# Weekly, Sunday 05:00, after the daily 04:15 Supreme Court sync. Upstream
# syncs daily; weekly batches the High Court work into one quiet-hours run.
# Persistent=true re-fires a run missed while the box was down.
[Unit]
Description=Weekly NyayaSearch High Court judgment sync

[Timer]
OnCalendar=Sun *-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
